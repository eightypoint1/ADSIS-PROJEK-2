# ============================================================
# .dockerignore — Nusantara Tech SIA
# ============================================================
# Project: PHP 8.2 + Laravel, Dockerized with Dockerfile
# Strategy: vendor/ installed INSIDE container via composer install.
#           Exclude everything not needed at runtime to keep
#           build context small and layers cacheable.
# ============================================================

# === GIT ===
# Repository metadata not needed in image
.git/
.gitignore
.gitattributes

# === ENVIRONMENT FILES ===
# .env contains real secrets — never bake into image
.env
# Keep .env.example (used as template reference)

# === DEPENDENCIES (installed inside Docker) ===
# vendor/ is generated by "composer install" in Dockerfile
vendor/
# No Node.js build pipeline in this project (Tailwind via CDN)
node_modules/
package.json
package-lock.json
.npmrc
vite.config.js

# === DOCKER / DEPLOYMENT FILES ===
# Deployment configs — not needed at runtime
docker-compose.yml
docker-compose.*.yml
Dockerfile
Dockerfile.*
.dockerignore

# === DOCUMENTATION ===
README.md
CLAUDE.md
*.md

# === TESTS ===
# Not needed at runtime in container
tests/
phpunit.xml
phpunit.xml.dist

# === OS / EDITOR CLUTTER ===
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig

# === LOGS ===
# Runtime logs — generated fresh in container
*.log
storage/logs/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/framework/testing/

# === CI / TOOLS ===
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# === LOCAL DEV ===
# SQLite database from local dev — Docker uses MySQL
database/database.sqlite
# Downloaded backups / dumps
*.sql.gz
*.sql.bz2
*.tar.gz

# === HOT RELOAD / WATCH FILES ===
# Not used inside production-like container
.nodemon
.watchmanconfig
